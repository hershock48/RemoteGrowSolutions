# Remote Grow Solutions. Kevin sets these in the Vercel dashboard. Never paste a secret into a file.

# The consultant door. /admin and every facility open with it. Minimum 4
# characters. Unset in production = the consultant side is CLOSED, not open
# on a default. Local development falls back to "rgs-dev".
RGS_ADMIN_PASSCODE=

# Storage. Vercel > Storage > Create Database > Neon (free tier) injects one of
# these, possibly with a prefix (the store matches any *_DATABASE_URL). With
# none set, a deployment runs on an in-memory embedded Postgres and every
# consultant screen says so; local development persists to .data/ instead.
DATABASE_URL=

# Local only. Makes a production build (`npm start`) open an on-disk store at
# this path instead of running in memory, so the gated screens can be audited
# on a real build with the seeded data. Never set on a deployment.
RGS_DATA_DIR=

# Canopy photos on check-ins. Vercel > Storage > Create Blob store injects it.
# Unset, the check-in form says photos are not switched on and saves without.
BLOB_READ_WRITE_TOKEN=
